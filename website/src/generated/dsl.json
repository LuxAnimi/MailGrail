            "matrix"
          ],
          "label": "Of arrays",
          "source": "t.object({ matrix: t.array(t.array(t.string())) })",
          "tsType": "{\n  matrix: string[][];\n}"
        }
      ],
      "id": "array",
      "notes": [],
      "seeAlso": [],
      "signature": "t.array(element): ArraySchema",
      "summary": "A repeated parameter, iterated with `mg.each`."
    },
    {
      "call": "t.optional",
      "description": "Use this when an absent value genuinely has nothing to show. To branch on one, reach for `mg.when`; in `subjectTemplate` and `textTemplate`, which receive plain params rather than a render context, guard it yourself.",
      "examples": [
        {
          "compiled": {
            "ejs": {
              "nickname": "<%= nickname %>"
            },
            "handlebars": {
              "nickname": "{{nickname}}"
            },
            "mustache": {
              "nickname": "{{nickname}}"
            }
          },
          "keys": [
            "nickname"
          ],
          "label": null,
          "source": "t.object({ nickname: t.optional(t.string()) })",
          "tsType": "{\n  nickname?: string;\n}"
        }
      ],
      "id": "optional",
      "notes": [],
      "seeAlso": [
        "default"
      ],
      "signature": "t.optional(schema): OptionalSchema",
      "summary": "The parameter may be omitted, and renders as nothing when it is."
    },
    {
      "call": "t.default",
      "description": "Omittable on input, never undefined at render time -- so a template can use it unguarded.",
      "examples": [
        {
          "compiled": {
            "ejs": {
              "role": "<%= role %>"
            },
            "handlebars": {
              "role": "{{role}}"
            },
            "mustache": {
              "role": "{{role}}"
            }
          },
          "keys": [
            "role"
          ],
          "label": null,
          "source": "t.object({ role: t.default(t.string(), \"user\") })",
          "tsType": "{\n  role?: string;\n}"
        }
      ],
      "id": "default",
      "notes": [
        "**`optional` vs `default`** — both let the caller leave the key out. They differ only in what appears when it is absent: nothing, or the stand-in value.",
        "`t.default(t.optional(t.string()), \"user\")` is valid and means exactly `t.default(t.string(), \"user\")`. The nesting is never required."
      ],
      "seeAlso": [
        "optional"
      ],
      "signature": "t.default(schema, value): DefaultedSchema",
      "summary": "The parameter may be omitted, and renders `value` when it is."
    }
  ]
}
