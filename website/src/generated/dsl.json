    {
      "call": "t.number",
      "description": "Rendered with the engine's default number formatting. Format it yourself -- currency, thousands separators -- before passing it in, since the compiled template has no access to your locale.",
      "examples": [
        {
          "compiled": {
            "ejs": {
              "invoiceTotal": "<%= invoiceTotal %>"
            },
            "handlebars": {
              "invoiceTotal": "{{invoiceTotal}}"
            },
            "mustache": {
              "invoiceTotal": "{{invoiceTotal}}"
            }
          },
          "keys": [
            "invoiceTotal"
          ],
          "label": null,
          "source": "t.object({ invoiceTotal: t.number() })",
          "tsType": "{\n  invoiceTotal: number;\n}"
        }
      ],
      "id": "number",
      "notes": [],
      "seeAlso": [],
      "signature": "t.number(): NumberSchema",
      "summary": "A numeric parameter."
    },
    {
      "call": "t.boolean",
      "description": "On its own a boolean renders as `true` or `false`. It is far more useful as the subject of `mg.when` or `mg.unless`.",
      "examples": [
        {
          "compiled": {
            "ejs": {
              "isAdmin": "<%= isAdmin %>"
            },
            "handlebars": {
              "isAdmin": "{{isAdmin}}"
            },
            "mustache": {
              "isAdmin": "{{isAdmin}}"
            }
          },
          "keys": [
            "isAdmin"
          ],
          "label": null,
          "source": "t.object({ isAdmin: t.boolean() })",
          "tsType": "{\n  isAdmin: boolean;\n}"
        }
      ],
      "id": "boolean",
      "notes": [],
      "seeAlso": [
        "render-context"
      ],
      "signature": "t.boolean(): BooleanSchema",
      "summary": "A true/false parameter, usually used to branch."
    },
    {
      "call": "t.object",
      "description": "Objects nest freely. Reach for `mg.with` in a template to scope to one and stop repeating the path prefix.",
      "examples": [
        {
          "compiled": null,
          "keys": [
            "address"
          ],
          "label": null,
          "source": "t.object({\n  address: t.object({\n    street: t.string(),\n    city: t.string(),\n    country: t.string(),\n  }),\n})",
          "tsType": "{\n  address: {\n    street: string;\n    city: string;\n    country: string;\n  };\n}"
        }
      ],
      "id": "object",
      "notes": [],
      "seeAlso": [],
      "signature": "t.object(shape): ObjectSchema",
      "summary": "A group of named parameters."
    },
    {
      "call": "t.array",
      "description": null,
      "examples": [
        {
          "compiled": null,
          "keys": [
            "tags"
          ],
          "label": "Of primitives",
          "source": "t.object({ tags: t.array(t.string()) })",
          "tsType": "{\n  tags: string[];\n}"
        },
        {
          "compiled": null,
          "keys": [
            "items"
          ],
          "label": "Of objects",
          "source": "t.object({\n  items: t.array(\n    t.object({\n      name: t.string(),\n      quantity: t.number(),\n      isFulfilled: t.boolean(),\n    }),\n  ),\n})",
          "tsType": "{\n  items: {\n    name: string;\n    quantity: number;\n    isFulfilled: boolean;\n  }[];\n}"
        },
        {
          "compiled": null,
