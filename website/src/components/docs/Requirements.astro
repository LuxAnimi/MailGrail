---
import meta from "../../generated/meta.json";
import engines from "../../generated/engines.json";
import { version } from "../../lib/version";
---

<dl class="req not-content">
  <div>
    <dt>Node</dt>
    <dd class="mg-tabular"><code>{engines.node}</code></dd>
  </div>
  <div>
    <dt>Modules</dt>
    <dd>ESM only</dd>
  </div>
  <div>
    <dt>Version</dt>
    <dd class="mg-tabular"><code>{version}</code></dd>
  </div>
  <div>
    <dt>Licence</dt>
    <dd>{meta.license}</dd>
  </div>
</dl>

<style>
  .req {
    display: grid;
    gap: 1px;
    margin-block: 1.25rem 1.75rem;
    background: var(--mg-rule);
    border: 1px solid var(--mg-rule);
  }

  @media (min-width: 34rem) {
    .req {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .req > div {
    background: var(--mg-black);
    padding: 0.75rem 0.9rem 0.85rem;
  }

  .req dt {
    margin: 0 0 0.3rem;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mg-dimmer);
  }

  .req dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--mg-envelope);
  }

  .req code {
    font-family: var(--mg-mono);
    font-size: 0.8125rem;
    color: var(--mg-envelope);
  }
</style>
