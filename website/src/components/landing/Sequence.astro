---
//----------------------------------------------------------------------------
// declare -> preview -> compile.
//
// Numbered because this genuinely is a sequence: you cannot preview before you
// declare, or compile before either. The glyphs are the mark's own primitives
// -- the construction square, the inner circle, the envelope flap -- rather
// than stock icons, so the marker set belongs to this product and no other.
//----------------------------------------------------------------------------
const steps = [
  {
    n: "01",
    glyph: "square",
    title: "Declare",
    body:
      "Describe the parameters with the <code>t</code> DSL. TypeScript infers the " +
      "types end to end, so a path that does not exist is a compile error rather " +
      "than a blank space in a sent email.",
  },
  {
    n: "02",
    glyph: "circle",
    title: "Preview",
    body:
      "<code>mailgrail preview</code> renders every template with placeholder data " +
      "generated from that same schema, and reloads on save. Desktop and mobile " +
      "widths, real MJML output.",
  },
  {
    n: "03",
    glyph: "flap",
    title: "Compile",
    body:
      "<code>mailgrail build</code> emits a readable template, a render function " +
      "and its type declarations. That output is what ships — mailgrail stays in " +
      "your devDependencies.",
  },
];
---

<section class="seq wrap" aria-labelledby="seq-heading">
  <div class="seq__head">
    <p class="mg-eyebrow" id="seq-heading">How it works</p>
    <p class="seq__lede">
      One schema does three jobs, which is the whole idea: rename a parameter and
      the template, the preview and the emitted types all move with it.
    </p>
  </div>

  <ol class="seq__list">
    {
      steps.map((step) => (
        <li class="step">
          <div class="step__top">
            <svg class="step__glyph" viewBox="0 0 24 24" aria-hidden="true">
              {step.glyph === "square" && (
                <>
                  <rect x="3.5" y="3.5" width="17" height="17" />
                  <rect x="8" y="8" width="8" height="8" stroke-opacity=".4" />
                </>
              )}
              {step.glyph === "circle" && (
                <>
                  <circle cx="12" cy="12" r="8.5" />
                  <circle cx="12" cy="12" r="4" stroke-opacity=".4" />
                </>
              )}
              {step.glyph === "flap" && (
                <>
                  <path d="M2.5 6.5h19v11h-19z" stroke-opacity=".4" />
                  <path d="M2.5 6.5 12 14l9.5-7.5" />
                </>
              )}
            </svg>
            <span class="step__n mg-tabular">{step.n}</span>
          </div>

          <h2 class="step__title">{step.title}</h2>
          <p class="step__body" set:html={step.body} />
        </li>
      ))
    }
  </ol>
</section>

<style>
  .seq {
    padding-block: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--mg-rule);
  }

  .seq__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 3rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .seq__lede {
    margin: 0;
    max-width: 52ch;
    color: var(--mg-dim);
    font-size: 0.9375rem;
  }

  /* 1px gaps over a ruled ground: separation without turning each step into
     a card, which would flatten the hierarchy. */
  .seq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--mg-rule);
    border-block: 1px solid var(--mg-rule);
  }

  @media (min-width: 46rem) {
    .seq__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step {
    background: var(--mg-black);
    padding: 1.5rem 1.4rem 1.75rem;
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .step__top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .step__glyph {
    width: 22px;
    height: 22px;
    flex: none;
    fill: none;
    stroke: var(--mg-gold);
    stroke-width: 1.25;
  }

  .step__n {
    font-family: var(--mg-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--mg-dimmer);
  }

  .step__title {
    margin: 0;
    font-family: var(--mg-display);
    font-weight: 400;
    font-size: 1.125rem;
    letter-spacing: -0.015em;
    color: var(--mg-envelope);
  }

  .step__body {
    margin: 0;
    color: var(--mg-dim);
    font-size: 0.9375rem;
  }

  .step__body :global(code) {
    font-size: 0.875em;
    color: var(--mg-envelope);
  }
</style>
