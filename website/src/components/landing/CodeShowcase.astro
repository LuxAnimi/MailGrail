---
import { Code } from "astro:components";
import context from "../../generated/context.json";

//----------------------------------------------------------------------------
// What you write, and what actually ships.
//
// Nothing here is typed by hand. The TSX is extracted from the fixture file by
// region marker; the three compiled outputs and the rendered HTML come from
// running mailgrail's real compiler at generate time, with a parity assertion
// between them. If the compiler's output changes, this section changes with it
// or CI fails.
//----------------------------------------------------------------------------
const fixture = context.fixtures.find((f) => f.id === "each-objects");
if (!fixture) throw new Error("CodeShowcase: fixture 'each-objects' is missing");

const engines = [
  { id: "ejs", label: "EJS", ext: ".ejs" },
  { id: "handlebars", label: "Handlebars", ext: ".hbs" },
  { id: "mustache", label: "Mustache", ext: ".mustache" },
] as const;

const pretty = (html: string) =>
  html
    .replace(/></g, ">\n<")
    .replace(/(<%|\{\{)/g, "\n$1")
    .replace(/\n{2,}/g, "\n")
    .trim();
---

<section class="show wrap" aria-labelledby="show-heading">
  <div class="show__head">
    <p class="mg-eyebrow" id="show-heading">One template, every engine</p>
    <h2 class="show__title">
      You write components. Your backend gets a template.
    </h2>
    <p class="show__lede">
      The same source compiles to EJS, Handlebars or Mustache. Every line below
      is generated by mailgrail's compiler when this page is built — and checked
      against what the preview server renders, so the page cannot drift from the
      product.
    </p>
  </div>

  <div class="show__grid">
    <figure class="pane">
      <figcaption class="pane__cap">
        <span class="pane__label">You write</span>
        <span class="pane__file">OrderEmail.tsx</span>
      </figcaption>
      <Code code={fixture.tsx} lang="tsx" theme="github-dark" />
    </figure>

    <figure class="pane">
      <figcaption class="pane__cap">
        <span class="pane__label">mailgrail build emits</span>
        <div class="tabs" role="tablist">
          {
            engines.map((engine, i) => (
              <>
                <input
                  class="tabs__radio"
                  type="radio"
                  name="engine"
                  id={`engine-${engine.id}`}
                  checked={i === 0}
                />
                <label class="tabs__tab" for={`engine-${engine.id}`}>
                  {engine.label}
                </label>
              </>
            ))
          }
        </div>
      </figcaption>

      {
        engines.map((engine) => (
          <div class={`panel panel--${engine.id}`}>
            <Code
              code={pretty(fixture.compiled[engine.id])}
              lang="html"
              theme="github-dark"
            />
          </div>
        ))
      }
    </figure>
  </div>

  <figure class="rendered">
    <figcaption class="pane__cap">
      <span class="pane__label">All three render identically</span>
      <span class="pane__badge">preview parity verified</span>
    </figcaption>
    <Code code={pretty(fixture.preview)} lang="html" theme="github-dark" />
  </figure>
</section>

<style>
  .show {
    padding-block: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--mg-rule);
  }

  .show__head {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .show__title {
    margin: 1rem 0 0;
    font-family: var(--mg-display);
    font-weight: 300;
    font-size: var(--mg-step-3);
    letter-spacing: -0.028em;
    line-height: 1.1;
    color: var(--mg-envelope);
    text-wrap: balance;
    max-width: 22ch;
  }

  .show__lede {
    margin: 1.1rem 0 0;
    max-width: 58ch;
    color: var(--mg-dim);
    font-size: 0.9375rem;
  }

  .show__grid {
    display: grid;
    gap: 1px;
    background: var(--mg-rule);
    border: 1px solid var(--mg-rule);
  }

  @media (min-width: 58rem) {
    .show__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pane {
    margin: 0;
    background: var(--mg-black);
    min-width: 0;
  }

  .pane__cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--mg-rule);
  }

  .pane__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mg-dim);
  }

  .pane__file {
    font-family: var(--mg-mono);
    font-size: 0.75rem;
    color: var(--mg-dimmer);
  }

  .pane__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--mg-gold);
  }

  .pane__badge::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mg-gold);
  }

  /*--- CSS-only tabs, no client JS --------------------------------*/

  .tabs {
    display: flex;
    gap: 0.15rem;
  }

  .tabs__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tabs__tab {
    padding: 0.25rem 0.55rem;
    border: 1px solid transparent;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mg-dimmer);
    cursor: pointer;
    transition: color 0.18s var(--mg-ease);
  }

  .tabs__tab:hover {
    color: var(--mg-envelope);
  }

  .tabs__radio:checked + .tabs__tab {
    color: var(--mg-gold);
    border-color: var(--mg-rule);
  }

  .tabs__radio:focus-visible + .tabs__tab {
    outline: 2px solid var(--mg-gold);
    outline-offset: 2px;
  }

  .panel {
    display: none;
  }

  .tabs:has(#engine-ejs:checked) ~ * .panel--ejs,
  .pane:has(#engine-ejs:checked) .panel--ejs,
  .pane:has(#engine-handlebars:checked) .panel--handlebars,
  .pane:has(#engine-mustache:checked) .panel--mustache {
    display: block;
  }

  /*--- Rendered ---------------------------------------------------*/

  .rendered {
    margin: 1.5rem 0 0;
    border: 1px solid var(--mg-rule);
    background: var(--mg-black);
  }

  /*--- Shiki ------------------------------------------------------*/

  .show :global(pre.astro-code) {
    margin: 0;
    padding: 1.05rem 1.15rem;
    background: var(--mg-raised) !important;
    font-size: 0.8125rem;
    line-height: 1.7;
    overflow-x: auto;
  }
</style>
