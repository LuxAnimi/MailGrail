  <g class="mark__grail" stroke="var(--logo-grail, #FFC840)">
    <path
      d="M -0.000752857 0.00149151 L -280.998928 0.00149151 C -248.498235 32.498278 -157.000192 28.998203 -104.999084 63.998949 C -53.001882 98.999695 -19.001158 201.001868 -19.001158 284.999751 C -143.999915 299.00005 -281.998949 444.999254 -281.998949 676.00027 L -281.998949 959.998508 L 294.001605 959.998508 L 294.001605 676.00027 C 294.001605 444.999254 158.998729 299.00005 30.999908 284.999751 C 30.999908 201.001868 65.000632 98.999695 117.00174 63.998949 C 168.998942 28.998203 260.500891 32.498278 293.001584 0.00149151 Z M -0.000752857 0.00149151"
      transform="matrix(0.999979, 0, 0, -0.999979, 697.985128, 1183.989773)"></path>
  </g>
</svg>

<style>
  .mark {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .mark--plain .mark__construction {
    display: none;
  }

  /*--- The draw-on ----------------------------------------------------
    The mark is a grail being *constructed* out of geometry, so it draws
    itself in that order: the scaffolding, then the envelope, then the
    grail. Scaffolding is the schema, envelope the template, grail what
    gets delivered.

    Path lengths vary a lot (a 1120-unit line vs a full circle), so one
    dasharray cannot fit them all. 4000 comfortably exceeds the longest,
    which makes every stroke draw at the same rate and finish early
    rather than stretching to fill its own duration.
  ------------------------------------------------------------------*/
  .mark--draw :is(.mark__construction, .mark__envelope, .mark__grail) path {
    stroke-dasharray: 4000;
    stroke-dashoffset: 4000;
    animation: mark-draw 1s var(--mg-ease, ease-out) forwards;
  }

  .mark--draw .mark__construction path {
    animation-duration: 0.85s;
  }
  .mark--draw .mark__construction path:nth-child(1) { animation-delay: 0s; }
  .mark--draw .mark__construction path:nth-child(2) { animation-delay: 0.06s; }
  .mark--draw .mark__construction path:nth-child(3) { animation-delay: 0.12s; }
  .mark--draw .mark__construction path:nth-child(4) { animation-delay: 0.16s; }
  .mark--draw .mark__construction path:nth-child(5) { animation-delay: 0.2s; }
  .mark--draw .mark__construction path:nth-child(6) { animation-delay: 0.24s; }
  .mark--draw .mark__construction path:nth-child(7) { animation-delay: 0.28s; }
  .mark--draw .mark__construction path:nth-child(8) { animation-delay: 0.32s; }
  .mark--draw .mark__construction path:nth-child(9) { animation-delay: 0.36s; }

  .mark--draw .mark__envelope path { animation-delay: 0.5s; }
  .mark--draw .mark__envelope path:nth-child(2) { animation-delay: 0.62s; }
  .mark--draw .mark__envelope path:nth-child(3) { animation-delay: 0.68s; }
  .mark--draw .mark__envelope path:nth-child(4) { animation-delay: 0.74s; }

  .mark--draw .mark__grail path {
    animation-delay: 0.95s;
    animation-duration: 1.15s;
  }

  @keyframes mark-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Show the finished mark, not an empty frame. */
  @media (prefers-reduced-motion: reduce) {
    .mark--draw :is(.mark__construction, .mark__envelope, .mark__grail) path {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
