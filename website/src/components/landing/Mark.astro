---
//----------------------------------------------------------------------------
// The brand mark, inline so its layers can be animated, recoloured and pulled
// apart in depth.
//
// Extracted from mailgrail.ai by website/scripts/extract-logo.mjs. Three
// layers: the construction geometry, the envelope, the grail.
//
//   detail={false}  drops the construction lines, which turn to mush below
//                   about 96px, and crops the viewBox to the remaining ink.
//   depth           renders each layer as its own plane in a preserve-3d
//                   stack, so a perspective on the parent separates them for
//                   real. `transform-style` is not honoured on SVG <g>, which
//                   is why the layers have to be sibling <svg> elements
//                   rather than groups inside one.
//   stroke          overrides the hairline weight. The stroke scales with the
//                   viewBox, so a mark drawn large needs a smaller number to
//                   keep the same optical weight.
//----------------------------------------------------------------------------
interface Props {
  /** Show the sacred-geometry scaffolding. Off for small sizes. */
  detail?: boolean;
  /** Play the draw-on sequence. Off everywhere but the hero. */
  animate?: boolean;
  /** Separate the layers in 3D. Needs a perspective on an ancestor. */
  depth?: boolean;
  /**
   * Draw a tick inside the construction circle.
   *
   * Not part of the artwork: it is the one glyph the mark is ever asked to
   * carry that is not in mailgrail.ai. It is inscribed in the inner circle of
   * the scaffolding -- the mark already had a circle the right size for it --
   * so it reads as something the geometry was waiting for rather than as an
   * icon dropped on top. Wants `detail`, since without the scaffolding that
   * circle is not drawn and the tick floats in the middle of nothing.
   */
  check?: boolean;
  /**
   * Draw this layer last, so it sits above the others.
   *
   * SVG paints in document order and has no z-index, so a caller that
   * highlights one layer cannot lift it from CSS -- the layers drawn after it
   * would keep crossing over the top of it.
   */
  front?: "construction" | "envelope" | "grail";
  /** Stroke width in viewBox units. Defaults by size. */
  stroke?: number;
  class?: string;
  /**
   * Accessible name. Pass "" where the mark is decorative -- beside a caption
   * that already says the same thing -- and it is hidden from assistive tech
   * instead of being announced as an image with no name.
   */
  title?: string;
}

const {
  detail = true,
  animate = false,
  depth = false,
  check = false,
  front,
  stroke,
  class: className = "",
  title = "MailGrail",
} = Astro.props;

// Without the construction layer the artwork no longer fills the square: the
// envelope spans x 224-1184 and the grail y 218-1190, so the full viewBox
// leaves a wide margin and shrinks the mark to sub-pixel strokes in the nav.
// Crop to the ink, and thicken the stroke to survive at 26px.
const viewBox = detail ? "0 0 1408 1408" : "194 188 1020 1022";
const strokeWidth = stroke ?? (detail ? 12 : 26);

const LAYERS = [
  {
    // The last four paths are the inner square and the cross that quarters
    // it: the wide rectangle through the middle and the two verticals that bar
    // it. They are kept at the end so they paint over the rest of the layer. Within a single-colour layer that
    // is invisible -- the hero draws the whole thing in one grey -- but it
    // matters wherever a caller lights them alone, since SVG has no z-index
    // and CSS cannot reorder them.
    id: "construction",
    colour: "var(--logo-construction, #414142)",
    /* Furthest back: the schema the rest is built on. The spread is one
       number, --mark-depth, because it is the only thing worth tuning here:
       at a 1500px perspective every 100px of Z is roughly 7% of scale, and
       past about 50 the layers stop reading as one mark. */
    z: "calc(var(--mark-depth, 34px) * -1)",
    paths: [
      { d: "M 0.00105116 -0.00149151 L 576.001605 -959.998508", t: "matrix(0.999979, 0, 0, -0.999979, 415.991136, 224.010227)" },
      { d: "M 0.00105116 0.00153412 L 576.001605 957.998508", t: "matrix(0.999979, 0, 0, -0.999979, 415.991136, 1181.989815)" },
      { d: "M -0.000838086 0 L 1117.999545 0", t: "matrix(0.999979, 0, 0, -0.999979, 143.996932, 704)" },
      { d: "M 1263.999588 704 L 1263.999588 143.999787 L 143.999162 143.999787 L 143.999162 1264.000213 L 1263.999588 1264.000213 Z", t: "matrix(0.999979, 0, 0, -0.999979, 0, 1407.985)" },
      { d: "M -0.000411941 0 C -0.000411941 309.280027 -250.720598 560.000213 -560.000625 560.000213 C -869.280652 560.000213 -1120.000838 309.280027 -1120.000838 0 C -1120.000838 -309.280027 -869.280652 -560.000213 -560.000625 -560.000213 C -250.720598 -560.000213 -0.000411941 -309.280027 -0.000411941 0 Z M -0.000411941 0", t: "matrix(0.999979, 0, 0, -0.999979, 1263.973068, 704)" },
      { d: "M 0.00160515 0 C 0.00160515 159.058077 -128.942548 287.998324 -288.000625 287.998324 C -447.058702 287.998324 -575.998949 159.058077 -575.998949 0 C -575.998949 -159.058077 -447.058702 -287.998324 -288.000625 -287.998324 C -128.942548 -287.998324 0.00160515 -159.058077 0.00160515 0 Z M 0.00160515 0", t: "matrix(0.999979, 0, 0, -0.999979, 991.978864, 704)" },
      { d: "M 1184.00179 704 L 1184.00179 224.001492 L 224.000866 224.001492 L 224.000866 1183.998508 L 1184.00179 1183.998508 Z", t: "matrix(0.999979, 0, 0, -0.999979, 0, 1407.985)" },
      { d: "M 0.00105116 -0.00151282 L 0.00105116 -956.998466", t: "matrix(0.999979, 0, 0, -0.999979, 415.991136, 225.010206)" },
      { d: "M 0.00160515 -0.00149151 L 0.00160515 -956.998445", t: "matrix(0.999979, 0, 0, -0.999979, 991.978864, 224.010227)" },
      { d: "M 1184.00179 704 L 1184.00179 991.998324 L 224.000866 991.998324 L 224.000866 416.001676 L 1184.00179 416.001676 Z", t: "matrix(0.999979, 0, 0, -0.999979, 0, 1407.985)" },
    ],
  },
  {
    id: "envelope",
    colour: "var(--logo-envelope, #D7DADD)",
    z: "0px",
    paths: [
    { d: "M 1184.00179 704 L 1184.00179 991.998324 L 224.000866 991.998324 L 224.000866 416.001676 L 1184.00179 416.001676 Z", t: "matrix(0.999979, 0, 0, -0.999979, 0, 1407.985)" },
    { d: "M 0.000894905 0.0000213073 L -367.999134 -288.998324", t: "matrix(0.999979, 0, 0, -0.999979, 591.987386, 703.000021)" },
    { d: "M 0.0017614 0 L 368.00179 -287.998324", t: "matrix(0.999979, 0, 0, -0.999979, 815.982614, 704)" },
    { d: "M 0.00178981 -0.00167617 L -480.000625 -369.001726 L -959.999134 -0.00167617", t: "matrix(0.999979, 0, 0, -0.999979, 1183.974773, 416.006136)" },
    ],
  },
  {
    id: "grail",
    colour: "var(--logo-grail, #FFC840)",
    /* Nearest: what actually gets delivered, so it comes furthest forward. */
    z: "calc(var(--mark-depth, 34px) * 1.15)",
    paths: [
    { d: "M -0.000752857 0.00149151 L -280.998928 0.00149151 C -248.498235 32.498278 -157.000192 28.998203 -104.999084 63.998949 C -53.001882 98.999695 -19.001158 201.001868 -19.001158 284.999751 C -143.999915 299.00005 -281.998949 444.999254 -281.998949 676.00027 L -281.998949 959.998508 L 294.001605 959.998508 L 294.001605 676.00027 C 294.001605 444.999254 158.998729 299.00005 30.999908 284.999751 C 30.999908 201.001868 65.000632 98.999695 117.00174 63.998949 C 168.998942 28.998203 260.500891 32.498278 293.001584 0.00149151 Z M -0.000752857 0.00149151", t: "matrix(0.999979, 0, 0, -0.999979, 697.985128, 1183.989773)" },
    ],
  },
];

// The tick, inscribed in the scaffolding's outer circle: centre 704,704 and
// radius 560 in the artwork's own coordinates. Its far corner reaches 0.64 of
// that radius, which is as far as it goes before the arm crowds the circle it
// sits in. Drawn in the mark's own units so it scales with everything else.
//
// It was first cut against the inner circle, at the same 0.64. Same tick, same
// centre, scaled by the ratio of the two radii -- which is the whole reason to
// size it off a circle the drawing already has rather than off a number.
const CHECK = "M 424 696 L 618 891 L 988 482";

// Heavier than the hairlines around it. At the construction stroke it was one
// more line in a drawing made of lines -- the tick has to read as the thing
// the drawing is saying, not as part of the grid.
const checkWidth = strokeWidth * 1.75;

// The circle the tick is cut against: the fifth path of the construction
// layer. Named here, beside the geometry, rather than picked out by position
// in a caller's stylesheet -- a re-extraction should check this still holds.
const CONSTRUCTION = LAYERS.find((l) => l.id === "construction");
const RING = CONSTRUCTION.paths[4];

const visible = detail ? LAYERS : LAYERS.filter((l) => l.id !== "construction");

// `front` only moves the layer to the end of the paint order. It keeps its own
// --plane-z, so the depth stack is unaffected.
const shown = front
  ? [...visible.filter((l) => l.id !== front), ...visible.filter((l) => l.id === front)]
  : visible;

// SVG paints in document order and has no z-index, so the ring cannot be lit
// where it sits: five construction paths, the envelope and the grail are all
// drawn after it and cross over the top. It is lifted out of the layer and
// drawn with the tick instead, which puts both lit shapes last. Removed rather
// than copied, or the grey original would sit a hairline under the gold one.
const drawn =
  check
    ? shown.map((l) =>
        l.id === "construction"
          ? { ...l, paths: l.paths.filter((path) => path !== RING) }
          : l,
      )
    : shown;

// Decorative when it has no name to give.
const labelled = title !== "";

const classes = [
  "mark",
  detail ? "" : "mark--plain",
  animate ? "mark--draw" : "",
  depth ? "mark--depth" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  depth ? (
    <div
      class={classes}
      role={labelled ? "img" : undefined}
      aria-label={labelled ? title : undefined}
      aria-hidden={labelled ? undefined : "true"}
    >
      {drawn.map((layer) => (
        <svg
          class={`mark__plane mark__${layer.id}`}
          style={`--plane-z: ${layer.z}`}
          viewBox={viewBox}
          fill="none"
          stroke={layer.colour}
          stroke-width={strokeWidth}
          stroke-linecap="butt"
          stroke-linejoin="miter"
          stroke-miterlimit="10"
          aria-hidden="true"
        >
          {layer.paths.map((p) => (
            <path d={p.d} transform={p.t ?? undefined} />
          ))}
        </svg>
      ))}

      {check && (
        <svg
          class="mark__plane mark__check"
          style={`--plane-z: ${CONSTRUCTION.z}`}
          viewBox={viewBox}
          fill="none"
          stroke="var(--logo-grail, #FFC840)"
          stroke-width={strokeWidth}
          stroke-linecap="butt"
          stroke-linejoin="miter"
          stroke-miterlimit="10"
          aria-hidden="true"
        >
          <path d={RING.d} transform={RING.t} />
          <path d={CHECK} stroke-width={checkWidth} />
        </svg>
      )}
    </div>
  ) : (
    <svg
      class={classes}
      viewBox={viewBox}
      fill="none"
      stroke-width={strokeWidth}
      stroke-linecap="butt"
      stroke-linejoin="miter"
      stroke-miterlimit="10"
      role={labelled ? "img" : undefined}
      aria-label={labelled ? title : undefined}
      aria-hidden={labelled ? undefined : "true"}
    >
      {drawn.map((layer) => (
        <g class={`mark__${layer.id}`} stroke={layer.colour}>
          {layer.paths.map((p) => (
            <path d={p.d} transform={p.t ?? undefined} />
          ))}
        </g>
      ))}

      {/* Last, so both lit shapes paint over the geometry they sit in. The
          ring keeps the construction hairline it was drawn at; only the tick
          is thickened. */}
      {check && (
        <g class="mark__check" stroke="var(--logo-grail, #FFC840)">
          <path d={RING.d} transform={RING.t} />
          <path d={CHECK} stroke-width={checkWidth} />
        </g>
      )}
    </svg>
  )
}

<style>
  .mark {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /*--- Depth ----------------------------------------------------------
    Each layer is its own plane, pushed apart along Z. With a perspective
    on an ancestor the tilt then separates them visibly, instead of the
    depth existing only while the pointer moves.
  ------------------------------------------------------------------*/
  .mark--depth {
    position: relative;
    aspect-ratio: 1;
    transform-style: preserve-3d;
  }

  .mark__plane {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: translateZ(var(--plane-z, 0));
  }

  .mark--plain .mark__construction {
    display: none;
  }

  /*--- The reveal -----------------------------------------------------
    Two different treatments, because the layers are two different kinds
    of thing.

    The scaffolding is the schema -- it does not get drawn, it arrives.
    It fades up while settling forward from further back, so it reads as
    already existing and moving into place rather than being constructed
    stroke by stroke. That animation lives with whoever positions it,
    since it needs that context's resting depth and opacity.

    The envelope and the grail are drawn, following their own strokes,
    and slowly: they are what the scaffolding is there to produce, so
    they arrive after it has settled. Slowly is meant literally -- the
    whole sequence runs a little over eight seconds, and the grail alone
    takes nearly five. It is the first thing on the page and there is
    nothing waiting behind it, so it can afford to take its time.

    `both`, and the dash lives entirely in the keyframes: during the
    delay the `from` state hides the path, and at rest the `to` state
    drops the dasharray altogether. A dash pattern suppresses the join
    where a closed path meets itself, so going solid at rest lets the
    corners join properly again.

    Path lengths vary a lot (a 1120-unit line vs a full circle), so one
    dasharray cannot fit them all. 4000 comfortably exceeds the longest,
    which makes every stroke draw at the same rate and finish early
    rather than stretching to fill its own duration.
  ------------------------------------------------------------------*/
  .mark--draw :is(.mark__envelope, .mark__grail) path {
    animation: mark-draw 3.6s var(--mg-ease, ease-out) both;
  }

  .mark--draw .mark__envelope path { animation-delay: 1.8s; }
  .mark--draw .mark__envelope path:nth-child(2) { animation-delay: 2.3s; }
  .mark--draw .mark__envelope path:nth-child(3) { animation-delay: 2.55s; }
  .mark--draw .mark__envelope path:nth-child(4) { animation-delay: 2.8s; }

  .mark--draw .mark__grail path {
    animation-delay: 3.5s;
    animation-duration: 4.6s;
  }

  @keyframes mark-draw {
    from {
      stroke-dasharray: 4000;
      stroke-dashoffset: 4000;
    }
    99% {
      stroke-dasharray: 4000;
      stroke-dashoffset: 0;
    }
    to {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
  }

  /* Show the finished mark, not an empty frame. */
  @media (prefers-reduced-motion: reduce) {
    .mark--draw :is(.mark__envelope, .mark__grail) path {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      animation: none;
    }

    .mark--draw .mark__construction {
      animation: none;
    }
  }
</style>
