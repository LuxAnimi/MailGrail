---
import { href } from "../lib/href";
import Mark from "../components/landing/Mark.astro";
import meta from "../generated/meta.json";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const docsHref = href("/docs/getting-started/introduction");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={href("/logo/mailgrail.svg")} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="nav__inner">
        <a class="nav__brand" href={href("/")}>
          <Mark class="nav__mark" detail={false} />
          <span>mailgrail</span>
        </a>

        <nav class="nav__links" aria-label="Primary">
          <a href={docsHref}>Documentation</a>
          <a href={meta.npmUrl} rel="noreferrer noopener">npm</a>
          <a href={meta.repoUrl} rel="noreferrer noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="foot__inner">
        <div class="foot__brand">
          <Mark class="foot__mark" detail={false} />
          <div>
            <p class="foot__name">mailgrail</p>
            <p class="foot__meta mg-tabular">
              v{meta.version} · {meta.license} · Node {meta.node}
            </p>
          </div>
        </div>

        <nav class="foot__links" aria-label="Footer">
          <a href={docsHref}>Documentation</a>
          <a href={meta.repoUrl} rel="noreferrer noopener">GitHub</a>
          <a href={meta.npmUrl} rel="noreferrer noopener">npm</a>
          <a href={meta.issuesUrl} rel="noreferrer noopener">Issues</a>
        </nav>
      </div>
    </footer>

    <style is:global>
      @import "../styles/brand.css";

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--mg-black);
        color: var(--mg-envelope);
        font-family: var(--mg-body);
        font-weight: 300;
        font-size: var(--mg-step-0);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      :focus-visible {
        outline: 2px solid var(--mg-gold);
        outline-offset: 3px;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--mg-gold);
        color: var(--mg-black);
        padding: 0.6rem 1rem;
        z-index: 10;
      }
      .skip:focus {
        left: 0;
      }

      /* One wrapper owns the side gutter, so it can never be zeroed by a
         padding shorthand further down. */
      .wrap {
        max-width: var(--mg-maxw);
        margin-inline: auto;
        padding-inline: var(--mg-gutter);
      }

      code,
      pre {
        font-family: var(--mg-mono);
      }
    </style>

    <style>
      /*--- Nav --------------------------------------------------------*/
      .nav {
        border-bottom: 1px solid var(--mg-rule);
      }

      .nav__inner {
        max-width: var(--mg-maxw);
        margin-inline: auto;
        padding-inline: var(--mg-gutter);
        padding-block: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .nav__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        color: var(--mg-envelope);
        text-decoration: none;
        font-family: var(--mg-display);
        font-weight: 500;
        font-size: 1.0625rem;
        letter-spacing: -0.01em;
      }

      .nav__brand :global(.nav__mark) {
        width: 26px;
        flex: none;
      }

      .nav__links {
        display: flex;
        gap: clamp(1rem, 3vw, 2rem);
        font-size: 0.875rem;
      }

      .nav__links a {
        color: var(--mg-dim);
        text-decoration: none;
        transition: color 0.18s var(--mg-ease);
      }

      .nav__links a:hover,
      .nav__links a:focus-visible {
        color: var(--mg-gold);
      }

      /*--- Footer -----------------------------------------------------*/
      .foot {
        border-top: 1px solid var(--mg-rule);
        margin-top: clamp(3rem, 8vw, 6rem);
      }

      .foot__inner {
        max-width: var(--mg-maxw);
        margin-inline: auto;
        padding-inline: var(--mg-gutter);
        padding-block: clamp(2.5rem, 5vw, 3.5rem);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 2rem;
      }

      .foot__brand {
        display: flex;
        align-items: center;
        gap: 0.85rem;
      }

      .foot__brand :global(.foot__mark) {
        width: 34px;
        flex: none;
        opacity: 0.75;
      }

      .foot__name {
        margin: 0;
        font-family: var(--mg-display);
        font-weight: 500;
        color: var(--mg-envelope);
      }

      .foot__meta {
        margin: 0.15rem 0 0;
        font-size: 0.8125rem;
        color: var(--mg-dimmer);
      }

      .foot__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        align-items: center;
        font-size: 0.875rem;
      }

      .foot__links a {
        color: var(--mg-dim);
        text-decoration: none;
        transition: color 0.18s var(--mg-ease);
      }

      .foot__links a:hover,
      .foot__links a:focus-visible {
        color: var(--mg-gold);
      }
    </style>
  </body>
</html>
