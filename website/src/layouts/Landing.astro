---
import { href } from "../lib/href";
import Mark from "../components/landing/Mark.astro";
import meta from "../generated/meta.json";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const docsHref = href("/docs/getting-started/introduction");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={href("/logo/mailgrail.svg")} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="nav__inner">
        <a class="nav__brand" href={href("/")}>
          <Mark class="nav__mark" />
          <span>MailGrail</span>
        </a>

        <nav class="nav__links" aria-label="Primary">
          <a href={docsHref}>Documentation</a>
          <a href={meta.npmUrl} rel="noreferrer noopener">npm</a>
          <a href={meta.repoUrl} rel="noreferrer noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="foot__inner">
        <div class="foot__brand">
          <Mark class="foot__mark" />
          <div>
            <p class="foot__name">MailGrail</p>
            <p class="foot__meta mg-tabular">
              v{meta.version} · {meta.license} · Node {meta.node}
            </p>
          </div>
        </div>

        <nav class="foot__links" aria-label="Footer">
          <a href={docsHref}>Documentation</a>
          <a href={meta.repoUrl} rel="noreferrer noopener">GitHub</a>
          <a href={meta.npmUrl} rel="noreferrer noopener">npm</a>
          <a href={meta.issuesUrl} rel="noreferrer noopener">Issues</a>
        </nav>
      </div>
    </footer>

    <style is:global>
      @import "../styles/brand.css";

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        /* The hero's mark bleeds past the gutter on purpose. `clip` stops that
           from producing a sideways scroll, and unlike `hidden` it does not
           turn the body into a scroll container. */
        overflow-x: clip;
        background: var(--mg-black);
        color: var(--mg-envelope);
        font-family: var(--mg-body);
        font-weight: 300;
        font-size: var(--mg-step-0);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      :focus-visible {
        outline: 2px solid var(--mg-gold);
        outline-offset: 3px;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--mg-gold);
        color: var(--mg-black);
        padding: 0.6rem 1rem;
        z-index: 10;
      }
      .skip:focus {
        left: 0;
      }

      /* One wrapper owns the side gutter, so it can never be zeroed by a
         padding shorthand further down. */
      .wrap {
        max-width: var(--mg-maxw);
        margin-inline: auto;
        padding-inline: var(--mg-gutter);
      }

      /* For content that genuinely needs the width -- see --mg-maxw-wide. */
      .wrap--wide {
        max-width: var(--mg-maxw-wide);
      }

      code,
      pre {
        font-family: var(--mg-mono);
      }
    </style>

    <style>
      /*--- Nav --------------------------------------------------------*/
      .nav {
        /* Above the hero's mark, which bleeds upward past the hero box. */
        position: relative;
        z-index: 3;
        background: var(--mg-black);
        border-bottom: 1px solid var(--mg-rule);
      }

      .nav__inner {
        max-width: var(--mg-maxw);
        margin-inline: auto;
        padding-inline: var(--mg-gutter);
        /* Traded against the lockup below: the mark grew from 26px to 35px, so
           the padding comes off to match and the
           header stays the 76px it was. */
        padding-block: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      /* Bigger and lighter rather than smaller and bolder. At 17px/500 the
         wordmark was carrying its weight through stroke thickness, which reads
         as stout next to a mark drawn in hairlines; at 20px/300 it carries it
         through size instead. 300 is the display face's own weight, the one
         the hero headline is set in, and it matches a mark whose strokes are
         now a single pixel -- at 400 the type was the heaviest thing in the
         lockup. The tracking goes the other way at the same time, from
         -0.01em to +0.03em: negative tracking on a light weight closes the
         counters up, which is what made it feel crowded. */
      /* The header and footer wordmarks are the same lockup and are set from
         one rule, so they cannot drift apart again -- the footer had been left
         at 500 weight with no tracking while the header moved to 300. */
      .nav__brand,
      .foot__name {
        font-family: var(--mg-display);
        font-weight: 300;
        font-size: 1.25rem;
        letter-spacing: 0.03em;
        color: var(--mg-envelope);
      }

      .nav__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        text-decoration: none;
      }

      /* One pixel per stroke, exactly. stroke-width is in viewBox units, so the
         weight that renders as 1px is the viewBox over the drawn width -- at
         the component's default of 12 it was landing at 0.43px here, under
         half a pixel, which is why the grid came out as grey mush rather than
         as lines. Set in CSS rather than through the component's `stroke` prop
         because it has to follow the width at each breakpoint. */
      .nav__brand :global(.nav__mark),
      .foot__brand :global(.foot__mark) {
        width: 51px;
        stroke-width: calc(1408 / 51);
        flex: none;
      }

      /* Phones keep the lockup they had. The enlarged one does not fit beside
         the links below about 30rem -- the nav wraps to two rows and the
         header half again as tall -- and the construction grid is illegible at
         that size regardless, so there is nothing to be gained by carrying it
         down there. Measured: the original holds one line to 375px and wraps
         at 360px, and these values reproduce that exactly. */
      @media (max-width: 30rem) {
        .nav__inner {
          padding-block: 1.5rem;
        }

        .nav__brand,
        .foot__name {
          font-size: 1.0625rem;
          /* A step back up in weight and down in tracking: 300 at 17px goes
             thin, and the smaller size needs less air, not more. */
          font-weight: 400;
          letter-spacing: 0.01em;
          gap: 0.65rem;
        }

        .nav__brand :global(.nav__mark),
        .foot__brand :global(.foot__mark) {
          width: 26px;
          stroke-width: calc(1408 / 26);
        }
      }

      .nav__links {
        display: flex;
        gap: clamp(1rem, 3vw, 2rem);
        font-size: 0.875rem;
      }

      .nav__links a {
        color: var(--mg-dim);
        text-decoration: none;
        transition: color 0.18s var(--mg-ease);
      }

      .nav__links a:hover,
      .nav__links a:focus-visible {
        color: var(--mg-gold);
      }

      /*--- Footer -----------------------------------------------------*/
      .foot {
        border-top: 1px solid var(--mg-rule);
        margin-top: var(--mg-section-y);
      }

      .foot__inner {
        max-width: var(--mg-maxw);
        margin-inline: auto;
        padding-inline: var(--mg-gutter);
        padding-block: clamp(2.5rem, 6vw, 5rem);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 2rem;
      }

      .foot__brand {
        display: flex;
        align-items: center;
        gap: 0.8rem;
      }

      .foot__name {
        margin: 0;
      }

      .foot__meta {
        margin: 0.15rem 0 0;
        font-size: 0.8125rem;
        color: var(--mg-dimmer);
      }

      .foot__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        align-items: center;
        font-size: 0.875rem;
      }

      .foot__links a {
        color: var(--mg-dim);
        text-decoration: none;
        transition: color 0.18s var(--mg-ease);
      }

      .foot__links a:hover,
      .foot__links a:focus-visible {
        color: var(--mg-gold);
      }
    </style>
  </body>
</html>
