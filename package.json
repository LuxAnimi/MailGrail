{
  "name": "mailgrail",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rollup -c && tsc -p tsconfig.cli.json && cp -r dist-src lib/app",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:cli && npm run typecheck:vite",
    "typecheck:cli": "tsc -p tsconfig.cli.json",
    "typecheck:vite": "tsc -p tsconfig.vite.json"
  },
  "bin": {
    "mailgrail": "./lib/bin/mailgrail.js"
  },
  "exports": {
    ".": {
      "import": "./lib/src/config/index.js",
      "types": "./lib/src/config/index.d.ts"
    }
  },
  "files": [
    "lib",
    "example-emails"
  ],
  "license": "GPL-3.0",
  "dependencies": {
    "@faire/mjml-react": "^3.5.3",
    "ejs": "^3.1.10",
    "esbuild": "^0.27.2",
    "mjml": "^4.18.0",
    "mjml-browser": "^4.18.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-html": "^2.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mjml": "^4.7.4",
    "@types/mjml-browser": "^4.15.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "rollup": "^4.54.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.97.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0"
  }
}
